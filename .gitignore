# Unreal Engine 5 generated files and local caches
# https://dev.epicgames.com/documentation/en-us/unreal-engine/unreal-engine-directory-structure
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Generated files for source plugins, including plugins in category subfolders.
# Binary-only plugins need explicit exceptions for required precompiled binaries.
/Plugins/**/Binaries/
/Plugins/**/DerivedDataCache/
/Plugins/**/Intermediate/
/Plugins/**/Saved/

# Generated receipts and packaged output; keep authored Build/ resources/settings.
/Build/Receipts/
/Build/*/FileOpenOrder/
/PackagedBuilds/
/StagedBuilds/

# Local IDE state
.vs/
.vscode/
.idea/
ipch/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb

# Solution/project files regenerated by Unreal (including modern VS .slnx files)
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcproj
*.xcodeproj/
*.xcworkspace/

# Python editor scripting caches and local scratch output
__pycache__/
*.py[cod]
/tmp/
/Docs/

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Keep Source/, Config/, Content/ (including .uasset/.umap and baked map data),
# authored Build/ files, Scripts/, .uproject/.uplugin files, and .vsconfig.
# Do not globally ignore DLLs/LIBs: third-party SDKs may require them in source control.
